{
  "name": "ravenpost-inbox",
  "private": true,
  "description": "Ravenpost's inbox: its Battle.net sign-in, and what the game told the players who said yes to the addons' opt-in, held until wow-data takes it",
  "type": "module",
  "scripts": {
    "dev": "INBOX_DEV=1 INBOX_TOKEN=local PORT=3003 bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "check": "tsc --noEmit && bun test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@vercel/blob": "^2.8.2",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "undici": "6.29.1",
    "zod": "4.6.7"
  }
}
